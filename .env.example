# --- Claude (AI extraction) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# Public demo protection: upload size limit and live AI extractions per visitor IP per hour
MAX_UPLOAD_MB=5
EXTRACT_RATE_LIMIT_PER_HOUR=30

# --- PayPal sandbox: the paying company (JP business account app) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox test account that receives demo payouts instead of the vendor's real email
PAYPAL_RECEIVER_EMAIL=sb-xxxxxxxx@business.example.com

# --- Safety switch: true = simulate payouts (no sandbox balance used) ---
PAYOUT_DRY_RUN=true

# --- Dev tools only (tools/return_funds.py, tools/auto_refill.py) ---
# Second sandbox app linked to the vendor test account; sends demo funds back to the JP account
RETURN_PAYPAL_CLIENT_ID=
RETURN_PAYPAL_CLIENT_SECRET=
PAYPAL_SENDER_EMAIL=sb-xxxxxxxx@business.example.com
